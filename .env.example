# Copia este archivo como .env (no se sube a GitHub) y completa tus claves.
# Stripe, modo test: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...

# Catálogo de demostración: maquinaria y herramientas con fotos (se carga una vez al arrancar).
DEMO_DATA_ENABLED=true
# Contraseña de los administradores de las empresas demo. Elige la tuya; no la subas a GitHub.
DEMO_PASSWORD=

# WhatsApp por Twilio para reenviar comprobantes: https://console.twilio.com
TWILIO_ACCOUNT_SID=AC...
TWILIO_API_KEY_SID=SK...
TWILIO_API_KEY_SECRET=
# o, en lugar de la API key, el Auth Token de la cuenta:
TWILIO_AUTH_TOKEN=
# Número del sandbox de TU cuenta: Messaging > Try it out > Send a WhatsApp message
TWILIO_WHATSAPP_FROM=+1...

# WhatsApp Empresas para reenviar comprobantes: panel.whatsappempresas.com > Dispositivos (API key del dispositivo).
# Si esta clave existe, se usa en lugar de Twilio.
WHATSAPP_EMPRESAS_TOKEN=
