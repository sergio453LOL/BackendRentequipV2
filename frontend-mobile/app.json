{
  "expo": {
    "name": "RentEquip",
    "slug": "rentequip",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "pe.rentequip.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0F172A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "pe.rentequip.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      [
        "expo-camera",
        {
          "cameraPermission": "RentEquip usa la cámara para fotografiar el estado de la maquinaria al entregarla y al devolverla.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "RentEquip usa tu ubicación para mostrarte maquinaria cerca de tu obra."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "RentEquip necesita acceder a tus fotos para adjuntar el estado de la maquinaria cuando no puedes usar la cámara."
        }
      ],
      "expo-font"
    ],
    "scheme": "rentequip"
  }
}
